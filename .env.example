# Never commit real values to .env files.
# This file is for DEVELOPMENT only: DATABASE_URL must point to the DEV Supabase project,
# never to production. Production secrets live only in the Azure Container App configuration.
# Supabase PostgreSQL. Dashboard > Connect > Session pooler: copy the connection string and
# replace [YOUR-PASSWORD] with the database password (Project Settings > Database).
# URL-encode special characters in the password (for example + becomes %2B).
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Supabase requires TLS. Use "disable" (default) only for a plain local PostgreSQL.
DATABASE_SSL=require
# Optional: path to the CA certificate to verify the server certificate (host runs only;
# the Docker api container uses "require" without verification).
# DATABASE_SSL_CA=/path/to/prod-ca-2021.crt
SESSION_SECRET=replace-with-a-unique-secret-at-least-32-characters
# ADMIN_EMAIL=admin@example.com
# Absolute http(s) URL allowed for credentialed cross-origin requests.
# CORS_ORIGIN=http://localhost:5173
PORT=3000
# Outbound email (optional). When SMTP_URL is unset, messages are logged to the console
# instead of being delivered, so local development works without a mail server.
# MAIL_FROM is required when SMTP_URL is set.
SMTP_URL=smtps://resend:replace-with-your-resend-api-key@smtp.resend.com:465
MAIL_FROM=no-reply@conjuros.app
# Absolute http(s) URL used to build password reset links (defaults to CORS_ORIGIN).
APP_BASE_URL=http://localhost:5173
# How long a password reset link stays valid, in minutes (default 60).
PASSWORD_RESET_TTL_MINUTES=60

# Attachment file storage (optional). Both SUPABASE_* values are required together; without
# them file endpoints answer 503. The service role key is server-only: never expose it.
# SUPABASE_URL must be an absolute https URL.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
# ATTACHMENT_BUCKET=attachments
# THEME_ASSET_BUCKET=assets
# ATTACHMENT_MAX_BYTES=52428800
