# Never commit real values to .env files.
# Docker Compose passes the POSTGRES_* values to the database container and builds the api
# container's DATABASE_URL from them. POSTGRES_PASSWORD is required and sits inside a URL,
# so use only URL-safe characters (letters, digits, - . _ ~).
POSTGRES_USER=conjuros
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=conjuros
# Used by an API started on the host (npm run dev); keep it consistent with the values above.
DATABASE_URL=postgres://conjuros:replace-with-a-url-safe-password@localhost:5432/conjuros
SESSION_SECRET=replace-with-a-unique-secret-at-least-32-characters
# ADMIN_EMAIL=admin@example.com
# CORS_ORIGIN=http://localhost:5173
PORT=3000
# Outbound email (optional). When SMTP_URL is unset, messages are logged to the console
# instead of being delivered, so local development works without a mail server.
# MAIL_FROM is required when SMTP_URL is set.
SMTP_URL=smtps://resend:replace-with-your-resend-api-key@smtp.resend.com:465
MAIL_FROM=no-reply@conjuros.app
# Base URL used to build password reset links (defaults to CORS_ORIGIN).
APP_BASE_URL=http://localhost:5173
# How long a password reset link stays valid, in minutes (default 60).
PASSWORD_RESET_TTL_MINUTES=60
