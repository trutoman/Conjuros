FROM node:22-alpine AS build

WORKDIR /app

COPY package.json ./
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages

RUN corepack enable
RUN corepack prepare pnpm@11.23.0 --activate

RUN pnpm install

COPY tsconfig.json vite.config.ts ./
COPY scripts ./scripts
COPY src ./src

RUN pnpm run build

FROM nginx:stable-alpine

# Azure Container Apps is the production target, where the API shares the
# replica network namespace. docker compose overrides this with "api:3000".
ENV API_UPSTREAM=localhost:3000
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist/web /usr/share/nginx/html

EXPOSE 80